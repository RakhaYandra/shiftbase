PORT=8080
DB_DSN=shift:shiftpass@tcp(localhost:3306)/shiftbase?parseTime=true&loc=Local
FRONTEND_URL=http://localhost:5173

# WAJIB diisi, minimal 32 karakter. Generate:
#   openssl rand -hex 32
# API menolak start tanpa ini (config.Load -> error), dan docker compose
# menolak start juga. Jangan pakai nilai contoh di sini sebagai kunci asli.
JWT_SECRET=ISI_MIN_32_KARAKTER_ACAK
